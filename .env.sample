APP_ENV=development

# DB credentials (these can be overridden at runtime)
DATABASE_USERNAME=brkmn_development
DATABASE_PASSWORD=so_wow_much_secure
DATABASE_DB_NAME=brkmn_development
DATABASE_HOST=db
DATABASE_PORT=5432

# Rails
RAILS_ENV=development
# Generated by docker/entrypoint.sh for new env files, or run: bin/rails secret
SECRET_KEY_BASE=

# Authentication type: db, cas, saml, or headers
DEVISE_AUTH_TYPE=db

# Header auth: IPs or CIDR ranges of the auth proxy, comma separated. Requests
# from other addresses can't log in with X-Auth-* headers. Default: loopback.
AUTH_HEADERS_TRUSTED_PROXIES=127.0.0.1,::1

# CAS auth
CAS_DATA_DIRECTORY=/app/tmp
DEVISE_CAS_AUTH_URL=db
DEVISE_CAS_AUTH_SERVICE_PATH=/users/service

# SAML auth
DEVISE_SAML_BASE_URL=http://127.0.0.1:3000
DEVISE_SAML_ASSERTION_CONSUMER_SERVICE_URL=
DEVISE_SAML_SP_ENTITY_ID=
DEVISE_SAML_IDP_ENTITY_ID=
DEVISE_SAML_IDP_SSO_SERVICE_URL=
DEVISE_SAML_IDP_SLO_SERVICE_URL=
DEVISE_SAML_SIGN_OUT_SUCCESS_URL=
DEVISE_SAML_IDP_CERT=
DEVISE_SAML_IDP_CERT_FINGERPRINT=
DEVISE_SAML_IDP_CERT_FINGERPRINT_ALGORITHM=http://www.w3.org/2001/04/xmlenc#sha256
DEVISE_SAML_DEFAULT_USER_KEY=email
DEVISE_SAML_EMAIL_ATTRIBUTE=email,mail
DEVISE_SAML_USERNAME_ATTRIBUTE=username,uid
DEVISE_SAML_DISPLAY_NAME_ATTRIBUTE=displayName,name
DEVISE_SAML_MEMBER_OF_ATTRIBUTE=memberOf
DEVISE_SAML_REQUIRED_MEMBER_OF=
DEVISE_SAML_USE_SUBJECT=false
DEVISE_SAML_VALIDATE_IN_RESPONSE_TO=false
DEVISE_SAML_ALLOWED_CLOCK_DRIFT=0

# JSON API (/api/v1)
# Requests allowed per token per period (seconds). Counters use Rails.cache.
API_RATE_LIMIT=300
API_RATE_LIMIT_PERIOD=300
# Comma-separated origins allowed to call the API from browser JavaScript ("*" = any).
API_CORS_ORIGINS=*

# SMTP settings
SMTP_ADDRESS=
SMTP_PORT=
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
# plain, login or cram_md5 (used when SMTP_USERNAME is set)
SMTP_AUTHENTICATION=plain
# peer (check the certificate) or none (only for a trusted relay with a self-signed certificate)
SMTP_OPENSSL_VERIFY_MODE=peer

# Demo data, see "Demo data" in README.md. It never loads in production.
# SEED_DEMO_DATA=true loads it on every start of docker/start_dev.sh.
# SEED_DEMO_DATA=true
# DEMO_GENERATED_LINKS=120
# DEMO_PASSWORD=brkmn-demo-password

# Rails specific
RAILS_ENV=development
# Production forces HTTPS and secure cookies. Set to true only when the app is
# not served over HTTPS at all.
RAILS_DISABLE_SSL=
# Host names the app answers to in production, comma separated. When empty,
# HOST, REDIRECT_DOMAIN and RAILS_HOSTNAME are used.
ALLOWED_HOSTS=
RAILS_LOG_LEVEL=error
