<!DOCTYPE html>
<html lang="en">
  <head>
    <%= capybara_lockstep if defined?(Capybara::Lockstep) %>
    <title><%= @page_title.blank? ? REDIRECT_DOMAIN : @page_title %></title>
    <meta name="apple-mobile-web-app-title" content="Brkmn">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%= image_url('icon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= image_url('icon.png') %>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= viewing_mode == 'classic' ? 'viewing-mode-classic' : 'viewing-mode-light' %> <%= controller.controller_name %>">
    <div class="wrapper">
      <div class="main-inner">
        <% if @current_user %>
          <%# Small screens show only Search and a Menu button, the other items open below it %>
          <nav
            class="header-items"
            aria-label="Main menu"
            data-controller="header-menu"
            data-action="click@window->header-menu#closeOnOutsideClick keydown.esc@window->header-menu#close turbo:before-cache@document->header-menu#close"
          >
            <div class="header-items-item-search" data-controller="search">
              <a data-action="click->search#toggle">
                <%= image_tag('search.svg', alt: '') %>
                <span>
                  Search
                </span>
              </a>

              <%= render partial: 'shared/search' %>
            </div>

            <button
              type="button"
              class="header-items-menu-toggle"
              aria-expanded="false"
              aria-controls="header-items-menu"
              data-header-menu-target="toggle"
              data-action="header-menu#toggle"
            >
              <%= image_tag('menu.svg', alt: '', class: 'header-items-menu-toggle-open') %>
              <%= image_tag('close.svg', alt: '', class: 'header-items-menu-toggle-close') %>
              <span>Menu</span>
            </button>

            <div class="header-items-menu" id="header-items-menu">
              <a
                class="header-items-item-bookmarklet"
                title="Drag this link to your bookmarks toolbar to shorten any page via <%= REDIRECT_DOMAIN %>"
                href="javascript:(function(){f='<%= bookmarklet_urls_url %>?url%5bto%5d='+encodeURIComponent(window.location.href)+'&';a=function(){if(!window.open(f+'noui=1&jump=doclose','brkmn','location=1,links=0,scrollbars=0,toolbar=0,width=1000,height=400'))location.href=f+'jump=yes'};if(/Firefox/.test(navigator.userAgent)){setTimeout(a,0)}else{a()}})()"
              >
                <span>
                  <%= image_tag('bookmark.svg', alt: '') %>
                </span>
                <span>
                  Shorten on <%= REDIRECT_DOMAIN %>
                </span>
              </a>

              <%= render 'theme/toggle_link' %>

              <%= link_to settings_path, title: 'API and account settings', class: 'header-items-item-settings' do %>
                <span>
                  <%= image_tag('settings.svg', alt: '') %>
                </span>
                <span>Settings</span>
              <% end %>

              <span class="header-items-item-account" title="<%= @current_user.email %>">
                <%= image_tag('user.svg', alt: '') %>
                <span class="header-items-item-user">
                  <%= @current_user.email %>
                </span>
              </span>

              <%= sign_out_link %>
            </div>
          </nav>
        <% end %>

        <h1 class="site-title is-size-2">
          <a href="<%= root_path %>" class="header-logo-link">
            <% if File.exist?(Rails.root.join('app', 'assets', 'images', 'logo.png')) %>
              <%= image_tag('logo.png', class: 'header-logo-image') %>
            <% end %>
            <%= REDIRECT_DOMAIN %>
          </a>
        </h1>

        <% visible_flash_messages.each do |name, msg| %>
          <div class="message" id="<%= name %>">
            <%= msg %>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </div>

    <footer>
      <%= ENV['FOOTER_TEXT'] || 'Berkman Klein Center for Internet & Society' %>
    </footer>
  </body>
</html>
