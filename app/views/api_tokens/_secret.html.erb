<%# Shows a plaintext token once. Rendered only in the response that created it. %>
<div class="api-tokens__secret" data-controller="clipboard" role="status">
  <h5><%= secret[:heading] %></h5>
  <p>
    <strong>Copy it now. You won't be able to see it again.</strong>
    Store it somewhere safe, such as a password manager.
  </p>

  <div class="api-tokens__secret-value">
    <code data-clipboard-target="source"><%= secret[:value] %></code>
    <button type="button" class="api-tokens__button" data-action="clipboard#copy" data-clipboard-target="button">
      Copy
    </button>
  </div>

  <p>
    <%= secret[:api_token].name %> ·
    <%= api_token_access_label(secret[:api_token]) %> ·
    expires <%= api_token_time(secret[:api_token].expires_at, blank: "never") %>
  </p>

  <pre class="api-tokens__code">curl -H "Authorization: Bearer <%= secret[:value] %>" <%= api_v1_me_url %></pre>
</div>
