<%= render 'devise/shared/site_title' %>

<h4 class="is-size-4 mb-2">Change your password</h4>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <%= f.label :password, "New password", class: 'label' %>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <div class="control">
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: 'input', required: true %>
    </div>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm new password", class: 'label' %>
    <div class="control">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'input', required: true %>
    </div>
  </div>

  <div class="actions">
    <button class="button is-rounded" type="submit">Change my password</button>
  </div>
<% end %>

<%= render "devise/shared/links" %>
