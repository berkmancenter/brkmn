<%# Coming back to this page after an action (delete, share without
    JavaScript, ...) is a Turbo refresh: change only what changed and keep
    the scroll position. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= render partial: 'shared/add_url' %>

<hr>

<%# No Turbo frame per list: a page or sort link reloads both lists, so each
    link has the page of the other list and "back" shows both as they were. %>
<div id="my_urls" data-controller="urls-table row-animations">
  <h4 class="is-size-4">
    <div>My URLs</div>
  </h4>

  <div class="urls-table-wrapper">
    <% if @my_urls.present? %>
      <%= render 'shared/url_list', urls: @my_urls, page_param: :my_page, list_id: "my_urls" %>
    <% else %>
      <div class="notification">
        There are no URLs to display.
      </div>
    <% end %>
  </div>
</div>

<hr>

<div id="not_my_urls" data-controller="urls-table row-animations">
  <h4 class="is-size-4">
    <div>All URLs</div>
  </h4>

  <div class="urls-table-wrapper">
    <% if @not_my_urls.present? %>
      <%= render 'shared/url_list', urls: @not_my_urls, page_param: :others_page, list_id: "not_my_urls" %>
    <% else %>
      <div class="notification">
        There are no URLs to display.
      </div>
    <% end %>
  </div>
</div>
