<div id="<%= dom_id(url, :people_with_access) %>">
  <% collaborations = ordered_url_collaborators(url) %>
  <% if url.user.present? || collaborations.any? %>
    <section class="link_details__section">
      <h3>People with access</h3>
      <% if url.user.present? %>
        <div class="link_details__person">
          <div class="link_details__avatar" aria-hidden="true">
            <%= user_email_initial(url.user) %>
          </div>
          <span class="link_details__email"><%= user_email_address(url.user) %></span>
          <span class="link_details__role">Owner</span>
        </div>
      <% end %>

      <% collaborations.each do |collaboration| %>
        <div class="link_details__person">
          <div class="link_details__avatar" aria-hidden="true">
            <%= user_email_initial(collaboration.user) %>
          </div>
          <span class="link_details__email"><%= user_email_address(collaboration.user) %></span>
          <% if can?(:share, url) %>
            <% remove_label = "Remove edit access for #{user_email_address(collaboration.user)}" %>
            <% remove_data = {turbo_confirm: "Remove this user's edit access?"} %>
            <%= form_with url: url_collaborator_path(url, collaboration), method: :delete, data: remove_data do |form| %>
              <%= form.button class: "link_details__remove", title: "Remove access", aria: {label: remove_label} do %>
                <%= image_tag("delete.svg", alt: "") %>
              <% end %>
            <% end %>
          <% else %>
            <span class="link_details__role">Editor</span>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
