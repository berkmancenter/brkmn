<tr>
  <td class="shortened">
    <div>
      <div class="shortened-title">
        <%= link_to(url_list.shortened, shortened_url(url_list.shortened)) %>
      </div>
      <div
        class="shortened-actions"
        data-controller="url-details"
        data-url-details-details-url-value="<%= details_url_path(url_list) %>"
        data-url-details-auto-open-value="<%= modal_error_for(url_list).present? %>">
        <div>
          <a class="urls-table-clipboard"
            title="Click to copy to clipboard"
            data-action="click->urls-table#copy"
            data-url="<%= shortened_url(url_list.shortened) %>">
            <%= image_tag('clipboard.svg', title: 'Copy url to clipboard') %>
          </a>
        </div>

        <div>
          <%= link_to(qr_url_path(url_list), target: '_blank', title: 'Show QR code for this url') do %>
            <%= image_tag('qr.svg') %>
          <% end %>
        </div>

        <div>
          <% if can?(:update, url_list) %>
            <%= link_to(edit_url_path(url_list), title: 'Edit', data: { turbo: false }) do %>
              <%= image_tag('edit.svg') %>
            <% end %>
          <% end %>

          <% if can?(:destroy, url_list) %>
            <%= link_to(url_path(url_list), title: 'Delete', method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this?" }) do %>
              <%= image_tag('delete.svg') %>
            <% end %>
          <% end %>
        </div>

        <div>
          <button
            type="button"
            class="link_details_button"
            title="Sharing and link details"
            aria-label="View sharing and link details for <%= url_list.shortened %>"
            data-action="url-details#open">
            <%= can?(:share, url_list) ? "Share" : "Details" %>
          </button>
          <%= render "urls/details_dialog", url: url_list %>
        </div>
      </div>

    </div>
  </td>
  <td class="arrow">→</td>
  <td class="to">
    <%= link_to(url_list.to, url_list.to) %>
  </td>
  <td class="created">
    <%= url_list.created_at.strftime("%Y-%m-%d %H:%M") %>
  </td>
  <td class="clicks">
    <%= url_list.clicks %>
  </td>
</tr>
